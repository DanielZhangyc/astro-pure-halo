{
  "name": "astro-pure-halo",
  "version": "0.1.7",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielZhangyc/astro-pure-halo.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "theme:watch": "nodemon --config nodemon.json --exec 'astro build'",
    "build:astro": "astro build",
    "build": "./scripts/package.sh",
    "check": "astro check",
    "halo:download": "./scripts/halo-download.sh",
    "halo:start": "./scripts/halo-start.sh",
    "halo:dev": "./scripts/dev.sh",
    "package": "./scripts/package.sh",
    "astro": "astro",
    "format": "prettier --write ."
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "dependencies": {
    "@unocss/astro": "66.6.8",
    "astro": "^6.1.4",
    "medium-zoom": "1.1.0",
    "qrcodejs": "1.0.0",
    "sharp": "^0.34.5",
    "unocss": "66.6.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@iconify-json/mingcute": "^1.2.7",
    "@unocss/preset-typography": "66.6.8",
    "@unocss/reset": "66.6.8",
    "nodemon": "^3.1.14",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^5.9.3"
  }
}

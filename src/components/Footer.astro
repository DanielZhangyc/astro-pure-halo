---
/*
 * Structure and styling copied from Astro Theme Pure 4.1.4 Footer.astro.
 */
import Icon from "./Icon.astro";
---

<footer class="mx-auto mb-5 mt-16 w-full">
  <div class="border-t pt-5">
    <div
      class="flex items-center gap-y-3 max-sm:flex-col sm:justify-between sm:gap-y-0"
    >
      <div
        class="flex items-center gap-x-4 gap-y-2 text-muted-foreground max-sm:flex-col"
      >
        <div
          th:if="${theme.config.footer.links != null and not #lists.isEmpty(theme.config.footer.links)}"
          class="flex items-center gap-x-2"
        >
          <th:block th:each="footerLink : ${theme.config.footer.links}">
            <a
              th:if="${footerLink.position == null or footerLink.position == 1}"
              th:href="${footerLink.link}"
              th:text="${footerLink.title}"
              th:classappend="${footerLink.style}"
              target="_blank"
              rel="noopener noreferrer"
            >
              Footer link
            </a>
          </th:block>
        </div>
        <div
          th:if="${theme.config.footer.registration != null and not #strings.isEmpty(theme.config.footer.registration)}"
        >
          <a
            th:href="${#strings.isEmpty(theme.config.footer.registration_url) ? null : theme.config.footer.registration_url}"
            th:target="${#strings.isEmpty(theme.config.footer.registration_url) ? null : '_blank'}"
            rel="noopener noreferrer"
            class="text-sm"
            th:text="${theme.config.footer.registration}"
          >
            Registration information
          </a>
        </div>
        <div>
          <span>© </span>
          <span
            th:if="${not #strings.isEmpty(theme.config.footer.start_year) and #strings.toString(theme.config.footer.start_year) lt #strings.toString(#dates.year(#dates.createNow()))}"
            th:text="|${theme.config.footer.start_year} - |"
          >
          </span>
          <span th:text="${#dates.year(#dates.createNow())}">2026</span>
          <span
            th:text="| ${#strings.isEmpty(theme.config.footer.copyright) ? site.title : theme.config.footer.copyright}|"
          >
            Site title
          </span>
          <th:block
            th:if="${(theme.config.footer.show_terms == null or theme.config.footer.show_terms) and (theme.config.footer.policy_title == null or not #strings.isEmpty(theme.config.footer.policy_title))}"
          >
            <span> &amp; </span>
            <a
              th:href="${#strings.isEmpty(theme.config.footer.policy_url) ? '/terms' : theme.config.footer.policy_url}"
              th:text="${#strings.isEmpty(theme.config.footer.policy_title) ? '站点条款' : theme.config.footer.policy_title}"
            >
              站点条款
            </a>
          </th:block>
          <th:block
            th:if="${theme.config.footer.links != null and not #lists.isEmpty(theme.config.footer.links)}"
            th:each="footerLink : ${theme.config.footer.links}"
          >
            <th:block th:if="${footerLink.position == 2}">
              <span> &amp; </span>
              <a
                th:href="${footerLink.link}"
                th:text="${footerLink.title}"
                th:classappend="${footerLink.style}"
                target="_blank"
                rel="noopener noreferrer"
              >
                Footer link
              </a>
            </th:block>
          </th:block>
        </div>
        <span
          th:if="${theme.config.footer.show_powered == null or theme.config.footer.show_powered}"
        >
          <a
            href="https://www.halo.run/"
            target="_blank"
            rel="noopener noreferrer">Halo</a
          >
          &amp;
          <a
            href="https://github.com/cworld1/astro-theme-pure"
            target="_blank"
            rel="noopener noreferrer">Pure</a
          >
          theme powered
        </span>
      </div>

      <div class="flex items-center gap-x-4">
        <th:block
          th:if="${theme.config.footer.social != null and not #lists.isEmpty(theme.config.footer.social)}"
          th:each="social : ${theme.config.footer.social}"
        >
          <a th:href="${social.href}" rel="me">
            <span class="sr-only" th:text="${social.label}">Social link</span>
            <svg
              aria-hidden="true"
              class="size-6"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="currentColor"
              set:html={'<use th:href="|#pure-icon-${social.icon}|"></use>'}
            />
          </a>
        </th:block>
        <a
          th:if="${(theme.config.footer.social == null or #lists.isEmpty(theme.config.footer.social)) and (theme.config.footer.show_github == null or theme.config.footer.show_github)}"
          href="https://github.com/DanielZhangyc/astro-pure-halo"
          rel="me"
        >
          <span class="sr-only">GitHub</span>
          <Icon name="github" />
        </a>
        <a
          th:if="${(theme.config.footer.social == null or #lists.isEmpty(theme.config.footer.social)) and (theme.config.footer.show_rss == null or theme.config.footer.show_rss)}"
          href="/rss.xml"
        >
          <span class="sr-only">RSS</span>
          <Icon name="rss" />
        </a>
      </div>
    </div>
  </div>
  <halo:footer></halo:footer>
</footer>

<style>
  footer a {
    color: hsl(var(--foreground) / var(--un-text-opacity, 1));
    text-decoration: underline;
    font-weight: 500;
  }
</style>

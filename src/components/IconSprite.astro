---
import { Icons } from "../lib/icons";

const names = [
  "github",
  "gitlab",
  "discord",
  "youtube",
  "instagram",
  "x",
  "telegram",
  "rss",
  "email",
  "reddit",
  "bluesky",
  "tiktok",
  "weibo",
  "steam",
  "bilibili",
  "zhihu",
  "coolapk",
  "netease",
  "time",
  "earth",
  "tag-2",
  "calendar",
  "hashtag",
] as const;
---

<svg
  aria-hidden="true"
  width="0"
  height="0"
  style="position:absolute;width:0;height:0;overflow:hidden"
>
  {
    names.map((name) => (
      <symbol
        id={`pure-icon-${name}`}
        viewBox="0 0 24 24"
        set:html={Icons[name]}
      />
    ))
  }
</svg>

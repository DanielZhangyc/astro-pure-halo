---
/*
 * Direct Halo port of Pure's CommonPage.astro.
 */
import ContentLayout from "./ContentLayout.astro";

interface Props {
  title: string;
  runtimeTitle?: string;
  comment?: boolean;
  commentGroup?: string;
  commentKind?: string;
  commentName?: string;
  commentStats?: boolean;
  view?: boolean;
}

const {
  title,
  runtimeTitle,
  comment = false,
  commentGroup = "content.halo.run",
  commentKind = "SinglePage",
  commentName = "${singlePage.metadata.name}",
  commentStats = true,
  view = false,
} = Astro.props;
const documentTitle = runtimeTitle
  ? `|${runtimeTitle} \${#strings.isEmpty(theme.config.general.title_delimiter) ? '•' : theme.config.general.title_delimiter} \${site.title}|`
  : `|${title} \${#strings.isEmpty(theme.config.general.title_delimiter) ? '•' : theme.config.general.title_delimiter} \${site.title}|`;
---

<ContentLayout>
  <Fragment slot="head">
    <title th:text={documentTitle}>
      {title} • Astro Theme Pure
    </title>
  </Fragment>

  <Fragment slot="header">
    <h1 class="text-2xl font-medium sm:mb-2 sm:text-3xl" th:text={runtimeTitle}>
      {title}
    </h1>
    {
      (view || (comment && commentStats)) && (
        <div class="text-base text-sm text-muted-foreground italic">
          <span th:text="${singlePage.stats.visit}">0</span> views
          {comment && (
            <>
              {" | "}
              <a href="#comments">
                <span th:text="${singlePage.stats.comment}">0</span> comments
              </a>
            </>
          )}
        </div>
      )
    }
  </Fragment>

  <slot />

  <Fragment slot="bottom">
    {
      comment && (
        <section
          id="comments"
          th:if="${(theme.config.post.enable_comments == null or theme.config.post.enable_comments) and haloCommentEnabled}"
          class="mt-3 sm:mt-6"
          aria-label="Comments"
        >
          <halo:comment
            group={commentGroup}
            kind={commentKind}
            th:attr={`name=${commentName}`}
          />
        </section>
      )
    }
  </Fragment>
</ContentLayout>

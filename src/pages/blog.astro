---
/*
 * Direct Halo port of Pure src/pages/blog/[...page].astro.
 * Halo custom pages do not receive a URL-aware paginated post collection, so
 * the page query parameter is passed to Halo's paginated PostFinder instead.
 */
import Icon from "../components/Icon.astro";
import PureButton from "../components/PureButton.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Fragment slot="head">
    <title
      th:text="|Blog ${#strings.isEmpty(theme.config.general.title_delimiter) ? '•' : theme.config.general.title_delimiter} ${site.title}|"
    >
      Blog • Astro Theme Pure
    </title>
    <meta name="description" content="Some posts or archives of my blog" />
  </Fragment>

  <th:block
    th:with="purePageSize=${theme.config.content.blog_page_size == null or theme.config.content.blog_page_size lt 1 ? 8 : theme.config.content.blog_page_size},
             pureRequestedPage=${not #lists.isEmpty(param.page) and param.page[0].matches('^[1-9][0-9]{0,5}$') ? param.page[0] : 1},
             requestedPosts=${postFinder.list({page: pureRequestedPage, size: purePageSize})},
             blogPosts=${requestedPosts.total gt 0 and #lists.isEmpty(requestedPosts.items) ? postFinder.list({page: requestedPosts.totalPages, size: purePageSize}) : requestedPosts},
             pureTags=${tagFinder.list(1, 50).items}"
  >
    <PureButton title="Back" href="/" variant="back" />
    <main class="mt-6 lg:mt-10">
      <div id="content-header" class="animate">
        <h1 class="mb-6 mt-6 text-3xl font-medium sm:mt-10">Blog</h1>
      </div>

      <p th:if="${blogPosts.total eq 0}">No posts yet.</p>
      <div
        th:if="${blogPosts.total gt 0}"
        class="grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8"
      >
        <section aria-label="Blog posts list" class="animate" id="content">
          <div
            class="mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row"
          >
            <span
              class="text-muted-foreground"
              th:text="|Page ${blogPosts.page} - Showing ${#lists.size(blogPosts.items)} of ${blogPosts.total} posts|"
            >
              Page 1 - Showing 8 of 8 posts
            </span>
            <a aria-label="View all blog by years" href="/archives">
              View all posts by years →
            </a>
          </div>

          <th:block
            th:replace="~{fragments/post-list :: postList(postItems=${blogPosts.items})}"
          ></th:block>
          <nav
            th:if="${blogPosts.totalPages gt 1}"
            class="mt-4 flex items-center gap-x-4 sm:mt-6"
            aria-label="Pagination"
          >
            <a
              th:if="${blogPosts.hasPrevious()}"
              th:href="${blogPosts.page eq 2 ? '/blog' : '/blog?page=' + (blogPosts.page - 1)}"
              class="me-auto py-2"
              href="/blog"
            >
              ← Previous Posts
            </a>
            <a
              th:if="${blogPosts.hasNext()}"
              th:href="|/blog?page=${blogPosts.page + 1}|"
              class="ms-auto py-2"
              href="/blog?page=2"
            >
              Next Posts →
            </a>
          </nav>
        </section>

        <aside
          class="animate"
          id="sidebar"
          th:if="${not #lists.isEmpty(pureTags)}"
        >
          <h2 class="mb-4 flex items-center text-lg font-medium">
            <Icon name="tag-2" class="me-2" />
            Tags
          </h2>
          <ul class="text-bgColor flex flex-wrap gap-2">
            <li th:each="pureTag : ${pureTags}">
              <a
                th:href="${pureTag.status.permalink}"
                class="group inline-flex items-center gap-x-1 rounded-xl bg-muted border px-2 py-1 text-sm text-muted-foreground transition-all hover:bg-card no-underline"
                th:text="${pureTag.spec.displayName}"
              >
                Tag
              </a>
            </li>
          </ul>
          <span class="mt-4 block sm:text-end">
            <a aria-label="View all blog categories" href="/tags">
              View all →
            </a>
          </span>
        </aside>
      </div>
    </main>
  </th:block>
</Layout>

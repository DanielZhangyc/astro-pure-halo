---
/*
 * Direct Halo port of Pure src/pages/blog/[...page].astro.
 * Halo custom pages do not receive a URL-aware paginated post collection.
 * All posts are rendered once and the Pure paginator is adapted client-side.
 */
import Icon from "../components/Icon.astro";
import PureButton from "../components/PureButton.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Fragment slot="head">
    <title th:text="|Blog • ${site.title}|">Blog • Astro Theme Pure</title>
    <meta
      name="description"
      content="Some posts or archives of my blog"
    />
  </Fragment>

  <th:block th:with="blogPosts = ${postFinder.listAll()}">
  <PureButton title="Back" href="/" variant="back" />
  <main class="mt-6 lg:mt-10">
    <div id="content-header" class="animate">
      <h1 class="mb-6 mt-6 text-3xl font-medium sm:mt-10">Blog</h1>
    </div>

    <p th:if="${#lists.isEmpty(blogPosts)}">No posts yet.</p>
    <div
      th:if="${not #lists.isEmpty(blogPosts)}"
      class="grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8"
    >
      <section aria-label="Blog posts list" class="animate" id="content">
        <div
          class="mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row"
        >
          <span
            id="blog-page-summary"
            class="text-muted-foreground"
            th:text="|Page 1 - Showing ${#lists.size(blogPosts) gt 10 ? 10 : #lists.size(blogPosts)} of ${#lists.size(blogPosts)} posts|"
          >
            Page 1 - Showing 8 of 8 posts
          </span>
          <a aria-label="View all blog by years" href="/archives">
            View all posts by years →
          </a>
        </div>

        <div id="blog-post-list">
          <th:block
            th:replace="~{fragments/post-list :: postList(postItems=${blogPosts})}"
          ></th:block>
        </div>
        <nav
          id="blog-pagination"
          th:if="${#lists.size(blogPosts) gt 10}"
          class="mt-4 flex items-center gap-x-4 sm:mt-6"
          aria-label="Pagination"
        >
          <a id="blog-previous" class="me-auto py-2" href="/blog">
            ← Previous Posts
          </a>
          <a id="blog-next" class="ms-auto py-2" href="/blog?page=2">
            Next Posts →
          </a>
        </nav>
      </section>

      <th:block th:with="pureTags = ${tagFinder.listAll()}">
        <aside
          class="animate"
          id="sidebar"
          th:if="${not #lists.isEmpty(pureTags)}"
        >
          <h2 class="mb-4 flex items-center text-lg font-medium">
            <Icon name="tag-2" class="me-2" />
            Tags
          </h2>
          <ul class="text-bgColor flex flex-wrap gap-2">
            <li th:each="pureTag : ${pureTags}">
              <a
                th:href="${pureTag.status.permalink}"
                class="group inline-flex items-center gap-x-1 rounded-xl bg-muted border px-2 py-1 text-sm text-muted-foreground transition-all hover:bg-card no-underline"
                th:text="${pureTag.spec.displayName}"
              >
                Tag
              </a>
            </li>
          </ul>
          <span class="mt-4 block sm:text-end">
            <a aria-label="View all blog categories" href="/tags">
              View all →
            </a>
          </span>
        </aside>
      </th:block>
    </div>
  </main>
  </th:block>

  <script>
    const blogPostList =
      document.querySelector<HTMLElement>("#blog-post-list > ul");
    const blogPostItems = Array.from(
      blogPostList?.children || [],
    ) as HTMLElement[];
    const blogPageSummary = document.getElementById("blog-page-summary");
    const blogPagination = document.getElementById("blog-pagination");
    const blogPrevious = document.getElementById(
      "blog-previous",
    ) as HTMLAnchorElement | null;
    const blogNext = document.getElementById(
      "blog-next",
    ) as HTMLAnchorElement | null;

    if (blogPostList && blogPostItems.length > 0) {
      const pageSize = 10;
      const totalPages = Math.ceil(blogPostItems.length / pageSize);
      const requestedPage = Number(
        new URLSearchParams(window.location.search).get("page") || "1",
      );
      const currentPage = Number.isInteger(requestedPage)
        ? Math.min(Math.max(requestedPage, 1), totalPages)
        : 1;
      const start = (currentPage - 1) * pageSize;
      const end = Math.min(start + pageSize, blogPostItems.length);

      blogPostItems.forEach((item, index) => {
        item.hidden = index < start || index >= end;
      });
      blogPostList.dataset.ready = "true";

      if (blogPageSummary) {
        blogPageSummary.textContent = `Page ${currentPage} - Showing ${end - start} of ${blogPostItems.length} posts`;
      }
      if (blogPagination) {
        blogPagination.hidden = totalPages <= 1;
      }
      if (blogPrevious) {
        blogPrevious.hidden = currentPage <= 1;
        blogPrevious.href =
          currentPage === 2 ? "/blog" : `/blog?page=${currentPage - 1}`;
      }
      if (blogNext) {
        blogNext.hidden = currentPage >= totalPages;
        blogNext.href = `/blog?page=${currentPage + 1}`;
      }
    }
  </script>

  <style is:global>
    #blog-post-list > ul:not([data-ready]) > .post-preview:nth-child(n + 11) {
      display: none;
    }
  </style>
</Layout>

---
/*
 * Direct Halo port of Pure src/pages/blog/[...page].astro.
 * A Halo category supplies the paginated post collection that Astro supplies
 * upstream, so the rendered structure remains unchanged.
 */
import Icon from "../components/Icon.astro";
import PureButton from "../components/PureButton.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Fragment slot="head">
    <title th:text="|Blog • ${site.title}|">Blog • Astro Theme Pure</title>
    <meta
      name="description"
      content="Some posts or archives of my blog"
    />
  </Fragment>

  <PureButton title="Back" href="/" variant="back" />
  <main class="mt-6 lg:mt-10">
    <div id="content-header" class="animate">
      <h1 class="mb-6 mt-6 text-3xl font-medium sm:mt-10">Blog</h1>
    </div>

    <p th:if="${posts.total eq 0}">No posts yet.</p>
    <div
      th:if="${posts.total gt 0}"
      class="grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8"
    >
      <section aria-label="Blog posts list" class="animate" id="content">
        <div
          class="mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row"
        >
          <span
            class="text-muted-foreground"
            th:text="|Page ${posts.page} - Showing ${#lists.size(posts.items)} of ${posts.total} posts|"
          >
            Page 1 - Showing 8 of 8 posts
          </span>
          <a aria-label="View all blog by years" href="/archives">
            View all posts by years →
          </a>
        </div>

        <th:block
          th:replace="~{fragments/post-list :: postList(postItems=${posts.items})}"
        ></th:block>
        <th:block th:replace="~{fragments/pagination}"></th:block>
      </section>

      <th:block th:with="pureTags = ${tagFinder.listAll()}">
        <aside
          class="animate"
          id="sidebar"
          th:if="${not #lists.isEmpty(pureTags)}"
        >
          <h2 class="mb-4 flex items-center text-lg font-medium">
            <Icon name="tag-2" class="me-2" />
            Tags
          </h2>
          <ul class="text-bgColor flex flex-wrap gap-2">
            <li th:each="pureTag : ${pureTags}">
              <a
                th:href="${pureTag.status.permalink}"
                class="group inline-flex items-center gap-x-1 rounded-xl bg-muted border px-2 py-1 text-sm text-muted-foreground transition-all hover:bg-card no-underline"
                th:text="${pureTag.spec.displayName}"
              >
                Tag
              </a>
            </li>
          </ul>
          <span class="mt-4 block sm:text-end">
            <a aria-label="View all blog categories" href="/tags">
              View all →
            </a>
          </span>
        </aside>
      </th:block>
    </div>
  </main>
</Layout>

---
/* Direct Halo port of Pure src/pages/404.astro. */
import PureButton from "../../components/PureButton.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <Fragment slot="head">
    <title
      th:text="|404 ${#strings.isEmpty(theme.config.general.title_delimiter) ? '•' : theme.config.general.title_delimiter} ${site.title}|"
    >
      404 • Astro Theme Pure
    </title>
    <meta content="Not found" name="description" />
  </Fragment>
  <div class="px-4 py-10 text-center sm:px-6 lg:px-8">
    <h1 class="block text-7xl font-bold sm:text-9xl">404</h1>
    <p class="mt-3 text-muted-foreground">Oops, something went wrong.</p>
    <p class="text-lg">Sorry, we couldn't find your page.</p>
    <PureButton title="Back to home" href="/" variant="ahead" class="mt-5" />
  </div>
</Layout>

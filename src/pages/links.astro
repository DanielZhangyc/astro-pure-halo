---
/*
 * Halo plugin-links adapter for Astro Theme Pure 4.1.4 links/index.astro.
 * The plugin owns the /links route and data; this template owns the Pure UI.
 */
import FriendList from "../components/FriendList.astro";
import CommonPage from "../layouts/CommonPage.astro";
---

<CommonPage
  title="Links"
  runtimeTitle="${linksTitle}"
  comment
  commentGroup="plugin.halo.run"
  commentKind="Plugin"
  commentName="${pluginName}"
  commentStats={false}
>
  <p>They're sorted randomly.</p>

  <nav
    th:if="${simpleGroups != null and not #lists.isEmpty(simpleGroups)}"
    aria-label="Link groups"
    class="not-prose mb-6 flex flex-wrap gap-2"
  >
    <a
      href="/links"
      th:href="@{/links}"
      th:classappend="${group == null ? 'bg-foreground text-background' : 'bg-muted text-muted-foreground hover:bg-card'}"
      class="rounded-xl border px-3 py-1.5 text-sm no-underline transition-colors"
    >
      All
    </a>
    <a
      th:each="item : ${simpleGroups}"
      th:href="@{/links(group=${item.metadata.name})}"
      th:text="${item.spec.displayName}"
      th:classappend="${group == item.metadata.name ? 'bg-foreground text-background' : 'bg-muted text-muted-foreground hover:bg-card'}"
      class="rounded-xl border px-3 py-1.5 text-sm no-underline transition-colors"
    >
      Group
    </a>
  </nav>

  <div th:if="${group == null}">
    <p th:if="${groups == null or #lists.isEmpty(groups)}">Nothing here.</p>
    <section th:each="item : ${groups}">
      <h2
        th:id="|link-group-${item.metadata.name}|"
        th:text="${#strings.isEmpty(item.spec.displayName) ? 'Ungrouped' : item.spec.displayName}"
      >
        Link group
      </h2>
      <FriendList
        friends={[]}
        runtimeSource="item.links"
        runtimeModel="plugin"
      />
    </section>
  </div>

  <div th:if="${group != null}">
    <FriendList friends={[]} runtimeSource="links" runtimeModel="plugin" />
  </div>

  <h2 id="apply-links">Apply Links</h2>
  <p>本站信息（点击复制）The site information (click to copy)：</p>
  <blockquote
    class="not-prose grid grid-cols-[auto_1fr] gap-x-2 break-words border-s-4 ps-4"
  >
    <span class="text-end">名称 Name:</span>
    <samp
      class="cursor-pointer"
      th:attr="data-copy=${site.title}"
      th:text="${site.title}">Site title</samp
    >

    <span class="text-end">简介 Intro:</span>
    <samp
      class="cursor-pointer"
      th:attr="data-copy=${site.subtitle}"
      th:text="${site.subtitle}">Site description</samp
    >

    <span class="text-end">地址 Link:</span>
    <samp
      class="cursor-pointer"
      th:attr="data-copy=${site.url}"
      th:text="${site.url}">https://example.com/</samp
    >

    <span class="text-end">头像 Avatar:</span>
    <samp
      class="cursor-pointer"
      th:attr="data-copy=${#strings.isEmpty(site.logo) ? site.url + '/favicon.ico' : site.logo}"
      th:text="${#strings.isEmpty(site.logo) ? site.url + '/favicon.ico' : site.logo}"
      >https://example.com/favicon.ico</samp
    >
  </blockquote>

  <p
    class="whitespace-pre-line"
    th:text="${#strings.isEmpty(theme.config.pages_links.apply_description) ? '可通过下方留言申请友链。申请前请先添加本站，并确保站点可以正常访问、具有正式域名、包含持续更新的原创内容，且内容不违反适用法律法规。' : theme.config.pages_links.apply_description}"
  >
    可通过下方留言申请友链。申请前请先添加本站，并确保站点可以正常访问、具有正式域名、包含持续更新的原创内容，且内容不违反适用法律法规。
  </p>
</CommonPage>

<script>
  document.querySelectorAll<HTMLElement>("[data-copy]").forEach((element) => {
    element.addEventListener("click", async () => {
      const value = element.dataset.copy || "";
      if (!value) return;
      await navigator.clipboard.writeText(value);
      document.dispatchEvent(
        new CustomEvent("pure-toast", {
          detail: { message: `Copied "${value}" to clipboard!` },
        }),
      );
    });
  });
</script>

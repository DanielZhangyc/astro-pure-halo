---
/*
 * Direct Halo port of Pure's CommonPage.astro.
 */
import ContentLayout from "../layouts/ContentLayout.astro";
---

<ContentLayout>
  <Fragment slot="head">
    <title
      th:text="|${singlePage.spec.title} ${#strings.isEmpty(theme.config.general.title_delimiter) ? '•' : theme.config.general.title_delimiter} ${site.title}|"
    >
      Page • Astro Theme Pure
    </title>
    <meta name="description" th:content="${singlePage.status.excerpt}" />
    <meta th:content="${singlePage.spec.title}" property="og:title" />
    <meta th:content="${singlePage.status.excerpt}" property="og:description" />
  </Fragment>

  <Fragment slot="header">
    <h1
      class="text-2xl font-medium sm:mb-2 sm:text-3xl"
      th:text="${singlePage.spec.title}"
    >
      Page title
    </h1>
  </Fragment>

  <div th:utext="${singlePage.content.content}"></div>

  <Fragment slot="bottom">
    <section
      th:if="${(theme.config.post.enable_comments == null or theme.config.post.enable_comments) and haloCommentEnabled}"
      class="mt-3 sm:mt-6"
      aria-label="Comments"
    >
      <halo:comment
        group="content.halo.run"
        kind="SinglePage"
        th:attr="name=${singlePage.metadata.name}"
      >
      </halo:comment>
    </section>
  </Fragment>
</ContentLayout>

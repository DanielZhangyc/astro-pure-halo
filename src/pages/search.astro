---
/* Direct Halo port of Pure src/pages/search/index.astro and PFSearch.astro. */
import PureSearch from "../components/PureSearch.astro";
import PureButton from "../components/PureButton.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Fragment slot="head">
    <title
      th:text="|Search ${#strings.isEmpty(theme.config.general.title_delimiter) ? '•' : theme.config.general.title_delimiter} ${site.title}|"
    >
      Search • Astro Theme Pure
    </title>
    <meta
      name="description"
      content="Search relative posts of the whole blog"
    />
  </Fragment>

  <PureButton title="Back" href="/blog" variant="back" />
  <main class="mt-6 lg:mt-10">
    <div id="content-header" class="animate">
      <h1 class="mb-6 text-3xl font-medium">Search</h1>
    </div>
    <div id="content" class="animate">
      <p>Enter a search term or phrase to search the blog.</p>
      <PureSearch />
    </div>
  </main>
</Layout>

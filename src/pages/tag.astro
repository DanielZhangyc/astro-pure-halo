---
/* Direct Halo port of Pure src/pages/tags/[tag]/[...page].astro. */
import PureButton from "../components/PureButton.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Fragment slot="head">
    <title
      th:text="|Tag: ${tag.spec.displayName} ${#strings.isEmpty(theme.config.general.title_delimiter) ? '•' : theme.config.general.title_delimiter} ${site.title}|"
    >
      Tag • Astro Theme Pure
    </title>
    <meta
      name="description"
      th:content="|View all posts with the tag - ${tag.spec.displayName}|"
    />
  </Fragment>

  <PureButton title="Back" href="/archives" variant="back" />
  <main class="mt-6 lg:mt-10">
    <div id="content-header" class="animate">
      <h1 class="mb-6 flex items-end gap-x-2 text-3xl font-medium">
        Tags:
        <span class="text-2xl" th:text="|#${tag.spec.displayName}|">#Astro</span
        >
      </h1>
    </div>

    <section id="content" class="animate" aria-label="Blog post list">
      <th:block
        th:replace="~{fragments/post-list :: postList(postItems=${posts.items})}"
      ></th:block>
      <th:block th:replace="~{fragments/pagination}"></th:block>
    </section>
  </main>
</Layout>
